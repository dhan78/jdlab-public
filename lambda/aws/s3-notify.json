{
  "LambdaFunctionConfigurations": [
    {
      "Id": "convert-stl",
      "LambdaFunctionArn": "arn:aws:lambda:<REGION>:<ACCOUNT_ID>:function:jdlab-scan-convert",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": { "Key": { "FilterRules": [
        { "Name": "prefix", "Value": "scans/raw/" },
        { "Name": "suffix", "Value": ".stl" }
      ] } }
    },
    {
      "Id": "convert-ply",
      "LambdaFunctionArn": "arn:aws:lambda:<REGION>:<ACCOUNT_ID>:function:jdlab-scan-convert",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": { "Key": { "FilterRules": [
        { "Name": "prefix", "Value": "scans/raw/" },
        { "Name": "suffix", "Value": ".ply" }
      ] } }
    },
    {
      "Id": "convert-obj-zip",
      "LambdaFunctionArn": "arn:aws:lambda:<REGION>:<ACCOUNT_ID>:function:jdlab-scan-convert",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": { "Key": { "FilterRules": [
        { "Name": "prefix", "Value": "scans/raw/" },
        { "Name": "suffix", "Value": ".zip" }
      ] } }
    }
  ]
}
