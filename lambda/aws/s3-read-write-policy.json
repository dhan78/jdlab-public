{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawScans",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::<SCAN_BUCKET>/scans/raw/*"
    },
    {
      "Sid": "WriteConvertedGlb",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::<SCAN_BUCKET>/scans/glb/*"
    },
    {
      "Sid": "ListRawScans",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::<SCAN_BUCKET>",
      "Condition": { "StringLike": { "s3:prefix": "scans/raw/*" } }
    },
    {
      "Sid": "ConsumeConvertQueue",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"],
      "Resource": "arn:aws:sqs:<REGION>:<ACCOUNT_ID>:jdlab-scan-convert"
    }
  ]
}
