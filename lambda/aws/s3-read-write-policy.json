{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawScans",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::<SCAN_BUCKET>/scans/raw/*"
    },
    {
      "Sid": "WriteConvertedGlb",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::<SCAN_BUCKET>/scans/glb/*"
    }
  ]
}
